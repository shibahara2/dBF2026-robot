# Copy to .env. Hosts: spark-3a50 = 10.17.2.171, spark-60c9 = 10.17.4.171.
# The settings that differ per environment are at the bottom:
# keep exactly one of the four blocks there uncommented.

# ---------------------------------------------------------------------------
# Common settings (same in every environment)
# ---------------------------------------------------------------------------

# Application settings
POLL_INTERVAL_SECONDS=2
HTTP_TIMEOUT_SECONDS=5
# Seconds to wait for R2's reply to play_navigation5
R2_START_REPLY_TIMEOUT_SECONDS=15
R2_WS_RECONNECT_DELAY_SECONDS=1
R2_WS_CONNECT_TIMEOUT_SECONDS=5

# External Themis video/VLM pipeline. VLM_ENDPOINT is vlm_server (or the VLM
# mock) and VISUAL_TRIGGER_URL is this app; both run on the same host as Flask.
VLM_ENDPOINT=http://127.0.0.1:5103/analyze
VLM_API_KEY=
VISUAL_TRIGGER_URL=http://127.0.0.1:5100/api/visual/start
# Seconds after which an abandoned kiosk entry no longer blocks visual/voice starts
ENTRY_IDLE_SECONDS=60

# VLM API server (python -m vlm_server). Serves VLM_ENDPOINT above and
# checks VLM_API_KEY when set. The backend (VLM_BACKEND_URL) is set per
# environment below.
VLM_BACKEND_MODEL=qwen3.6-35b-a3b
VLM_BACKEND_API_KEY=
VLM_SERVER_HOST=127.0.0.1
VLM_SERVER_PORT=5103
VLM_MAX_IMAGE_SIDE=640

# Mock server behavior (used only by run_mocks.py)
# Seconds per under_mode step of the /realtime mock
R2_MOCK_STEP_SECONDS=3
# success / fail / none (reply to play_navigation5)
R2_MOCK_START_REPLY=success
PF_MOCK_INITIALIZING_SECONDS=0
PF_MOCK_ACCEPTED=true
# Empty, or 422 / 500
PF_MOCK_FORCE_FAILURE=

# ---------------------------------------------------------------------------
# Per-environment settings: keep exactly one block uncommented.
# voice_ui does not read .env; its settings are in the comments of each block.
# ---------------------------------------------------------------------------

# --- mock: Flask on spark-3a50, R2 mock, AI管制PF mock ---------------------
# Start run_mocks.py on the same host (PF mock :5002, /realtime and /zed2i :9002).
# voice_ui on spark-60c9: FLASK_BASE_URL=http://10.17.2.171:5100
#                         DIALOGUE_LLM_URL=http://10.17.2.171:8080/v1
R2_WS_URL=ws://127.0.0.1:9002/realtime
THEMIS_WS_URL=ws://127.0.0.1:9002/zed2i
THEMIS_VLM_MODE=mock
PF_BASE_URL=http://localhost:5002
# Any non-empty value is accepted by the PF mock.
PF_API_KEY=mock-api-key
VLM_BACKEND_URL=http://localhost:8080/v1

# --- local mock: Flask on spark-60c9, R2 mock, AI管制PF mock ---------------
# Start run_mocks.py on spark-60c9. The LLM is spark-60c9's own llm container.
# voice_ui on spark-60c9: FLASK_BASE_URL and DIALOGUE_LLM_URL can be left unset
#                         (localhost:5100 and localhost:8080/v1)
# R2_WS_URL=ws://127.0.0.1:9002/realtime
# THEMIS_WS_URL=ws://127.0.0.1:9002/zed2i
# THEMIS_VLM_MODE=mock
# PF_BASE_URL=http://localhost:5002
# PF_API_KEY=mock-api-key
# VLM_BACKEND_URL=http://localhost:8080/v1

# --- 本番: Flask on spark-3a50, R2 実機, AI管制PF 本番 ---------------------
# R2 is reached through spark-60c9's forwarded port 9002
# (README "R2 (THEMIS) への接続"). Do not run run_mocks.py.
# voice_ui on spark-60c9: FLASK_BASE_URL=http://10.17.2.171:5100
#                         DIALOGUE_LLM_URL=http://10.17.2.171:8080/v1
# R2_WS_URL=ws://10.17.4.171:9002/realtime
# THEMIS_WS_URL=ws://10.17.4.171:9002/zed2i
# THEMIS_VLM_MODE=real
# PF_BASE_URL=https://reception.robility-system-stg.com
# PF_API_KEY=<key issued by the AI管制PF>
# VLM_BACKEND_URL=http://localhost:8080/v1

# --- local 本番: Flask on spark-60c9, R2 実機, AI管制PF 本番 ---------------
# spark-60c9 reaches the robot directly over THEMIS_5G; no forwarding needed.
# Stop Flask on spark-3a50 first (README "spark-60c9 で Flask（ステートマシン）を動かす場合").
# voice_ui on spark-60c9: FLASK_BASE_URL and DIALOGUE_LLM_URL can be left unset
#                         (localhost:5100 and localhost:8080/v1)
# R2_WS_URL=ws://192.168.0.11:9002/realtime
# THEMIS_WS_URL=ws://192.168.0.11:9002/zed2i
# THEMIS_VLM_MODE=real
# PF_BASE_URL=https://reception.robility-system-stg.com
# PF_API_KEY=<key issued by the AI管制PF>
# VLM_BACKEND_URL=http://localhost:8080/v1
