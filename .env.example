# Local mock servers (default)
R2_BASE_URL=http://localhost:5001
PF_BASE_URL=http://localhost:5002

# Real AI管制PF connection (replace PF_BASE_URL when switching from mocks)
# PF_BASE_URL=https://reception.robility-system-stg.com
# Any non-empty value is accepted by the local PF mock.
PF_API_KEY=mock-api-key
PF_PROXY_URL=

# Application settings
POLL_INTERVAL_SECONDS=2
HTTP_TIMEOUT_SECONDS=5
DRINK_TYPE=water
TARGET_ROBOT_ID=temi

# Mock server behavior
R2_MOCK_RETURNING_SECONDS=3
# Empty, or 422 / 500 / failed
R2_MOCK_FORCE_FAILURE=
PF_MOCK_INITIALIZING_SECONDS=0
PF_MOCK_ACCEPTED=true
# Empty, or 422 / 500
PF_MOCK_FORCE_FAILURE=

# Set this only when the network requires an explicit HTTPS proxy.
# PF_PROXY_URL=http://proxy.example.com:8080
